  "stack_metalearners": ["nnls", "linear", "lasso", "ridge", "elastic"],
  "r_entry_script": "rolling_window_check_mse.R",
  "output_files": [
    "output/baseline/mse_by_horizon_output.csv",
    "output/baseline/mse_average_ranking_output.csv",
    "output/baseline/forecast_rates_with_mse_output.csv"
