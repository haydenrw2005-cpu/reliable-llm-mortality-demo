# Cloud LLM (OpenAI-compatible). Groq free tier is the default endpoint.
GROQ_API_KEY=your_groq_api_key_here
# Or use a generic name:
# LLM_API_KEY=your_key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Pipeline: demo (cached CoMoMo tables) or full (local R)
PIPELINE_MODE=demo

# Only for PIPELINE_MODE=full — path to the original R entry script
# R_PIPELINE_SCRIPT=C:/path/to/rolling_window_check_mse_comomo_api_fixed_forecast_final.R
# HMD_USERNAME=
# HMD_PASSWORD=
# R_PIPELINE_TIMEOUT_SEC=28800
